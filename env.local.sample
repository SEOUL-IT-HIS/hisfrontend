# 복사: copy env.local.sample .env.local   (Windows)
#       cp env.local.sample .env.local     (Git Bash / macOS / Linux)
#
# Plan B (권장): axios baseURL 비움 → Next rewrite 가 MSA 로 전달
# NEXT_PUBLIC_ADMIN_API_BASE_URL 을 쓰면 rewrite 를 건너뛰므로 사용하지 않는다.
#
# .env.local 은 git 에 올리지 않는다. (.gitignore 의 .env*)
#
# admin-service (팀 공용)
ADMIN_API_ORIGIN=http://192.168.1.128:8080
#
# patient-service
# - 이 PC에서만 쓸 때: http://localhost:8080
# - LAN(다른 PC가 192.168.1.149:3000 접속)일 때: 아래 IP 사용
PATIENT_API_ORIGIN=http://192.168.1.149:8080
#
# surgery-service
# - 포트가 8080 이 아니라 8383 이다
# - 이 PC에서 수술 백엔드를 띄울 때: http://localhost:8383
SURGERY_API_ORIGIN=http://192.168.1.120:8383
#
# lab-imaging-service (검사/영상)
# - 검사·영상 화면(워크리스트, 동의서 등)이 전부 이 origin 을 탄다.
#   값이 틀리면 화면이 에러가 아니라 "타임아웃"으로 멈춘다. 없는 주소로 요청이 나가기 때문이다.
# - 이 PC에서 검사/영상 백엔드를 띄울 때: http://localhost:8080
# - 아니면 아래 IP(담당자 PC). DHCP 로 바뀔 수 있으니 안 되면 담당자에게 현재 IP 확인 요청.
LABIMAGING_API_ORIGIN=http://192.168.1.132:8080
