# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea/
.ai/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 로컬 문서는 추적하지 않는다.
#
# 개발표준가이드는 검사/영상 담당이 카카오톡으로 배포한다. 출처가 git 이 아니라서
# 레포에 넣으면 사본이 되고, 사본은 반드시 어긋난다.
# 실제로 2026-09-09 에 hisfrontend 루트·hisfrontend/docs·admin-service/docs 세 곳에
# 3.8 과 3.9 가 섞여 있었다. 받은 파일을 각자 로컬에 두고 쓴다.
/docs/코드분석-*.md
/docs/* (1).md
/docs/개발표준가이드.md
/개발표준가이드.md
